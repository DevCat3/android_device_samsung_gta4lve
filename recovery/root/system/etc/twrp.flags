# Logical partitions
/system               emmc               /dev/block/mapper/system                                   flags=backup=1;flashimg=1;wipeingui;logical;display="System"
/system_ext           emmc               /dev/block/mapper/system_ext                               flags=backup=1;flashimg=1;wipeingui;logical;display="System_ext"
/vendor               emmc               /dev/block/mapper/vendor                                   flags=backup=1;flashimg=1;wipeingui;logical;display="Vendor"
/product              emmc               /dev/block/mapper/product                                  flags=backup=1;flashimg=1;wipeingui;logical;display="Product"

# Physical partitions
/boot                 emmc               /dev/block/by-name/boot                                    flags=backup=1;display="Boot";flashimg=1
/recovery             emmc               /dev/block/by-name/recovery                                flags=backup=1;display="Recovery";flashimg=1
/dtbo                 emmc               /dev/block/by-name/dtbo                                    flags=backup=1;display="Dtbo";flashimg=1
/vbmeta               emmc               /dev/block/by-name/vbmeta                                  flags=backup=1;display="Vbmeta";flashimg=1
/vbmeta_system        emmc               /dev/block/by-name/vbmeta_system                           flags=backup=1;display="Vbmeta_System";flashimg=1
/misc                 emmc               /dev/block/by-name/misc
/cache                ext4               /dev/block/by-name/cache                                   flags=backup=1;display="Cache"
/metadata             ext4               /dev/block/by-name/metadata
# /data                 f2fs               /dev/block/by-name/userdata                                flags=backup=1;display="Metadata"
# /data                 ext4               /dev/block/by-name/userdata

# Removable storage
/external_sd          auto               /dev/block/mmcblk1p1    /dev/block/mmcblk1                 flags=display="Micro SD card";storage;wipeingui;removable
/usb-otg              auto               /dev/block/sda1         /dev/block/sda                     flags=display="USB-OTG";storage;wipeingui;removable
